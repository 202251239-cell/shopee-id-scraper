{
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "keyword": {
                "type": ["string", "null"],
                "title": "Search keyword",
                "description": "The search query used to find products on Shopee Indonesia.",
                "example": "laptop gaming"
            },
            "page": {
                "type": ["number", "null"],
                "title": "Page number",
                "description": "Which page of results this product appeared on.",
                "example": 1
            },
            "position": {
                "type": ["number", "null"],
                "title": "Position",
                "description": "Position in the search results (1-indexed).",
                "example": 1
            },
            "productId": {
                "type": ["number", "null"],
                "title": "Product ID",
                "description": "Shopee product ID (itemid).",
                "example": 123456789
            },
            "name": {
                "type": ["string", "null"],
                "title": "Product name",
                "description": "Full product title as shown in search results.",
                "example": "Earphone Gaming Stereo Bass Headset"
            },
            "price": {
                "type": ["number", "null"],
                "title": "Price (IDR)",
                "description": "Current selling price in Indonesian rupiah (converted from Shopee's cent pricing).",
                "example": 24900
            },
            "priceText": {
                "type": ["string", "null"],
                "title": "Price (formatted)",
                "description": "Display price exactly as Shopee renders it.",
                "example": "Rp24.900"
            },
            "priceMin": {
                "type": ["number", "null"],
                "title": "Min price (IDR)",
                "description": "Lowest variant price in Indonesian rupiah. Same as price when there's only one variant.",
                "example": 19900
            },
            "priceMax": {
                "type": ["number", "null"],
                "title": "Max price (IDR)",
                "description": "Highest variant price in Indonesian rupiah. Same as price when there's only one variant.",
                "example": 34900
            },
            "originalPrice": {
                "type": ["number", "null"],
                "title": "Original price (IDR)",
                "description": "Pre-discount price in Indonesian rupiah. Null when the product has no discount.",
                "example": 49900
            },
            "discount": {
                "type": ["number", "null"],
                "title": "Discount (IDR)",
                "description": "Absolute discount in rupiah. Null when there is no discount.",
                "example": 25000
            },
            "discountPercent": {
                "type": "number",
                "title": "Discount %",
                "description": "Discount percentage, 0 when the product has no discount.",
                "example": 50
            },
            "currency": {
                "type": "string",
                "title": "Currency",
                "description": "ISO currency code. Always IDR for Shopee Indonesia.",
                "example": "IDR"
            },
            "imageUrl": {
                "type": ["string", "null"],
                "title": "Main image URL",
                "description": "Main product image URL.",
                "example": "https://cf.shopee.co.id/file/abc123"
            },
            "imageUrls": {
                "type": "array",
                "title": "All image URLs",
                "description": "Array of all product image URLs.",
                "example": ["https://cf.shopee.co.id/file/abc123"]
            },
            "url": {
                "type": ["string", "null"],
                "title": "Product URL",
                "description": "Canonical product page URL on shopee.co.id.",
                "example": "https://shopee.co.id/product/123/456"
            },
            "shopId": {
                "type": ["number", "null"],
                "title": "Shop ID",
                "description": "Shopee shop/seller ID.",
                "example": 78901
            },
            "shopName": {
                "type": ["string", "null"],
                "title": "Shop name",
                "description": "Display name of the seller.",
                "example": "Toko Official Brand"
            },
            "shopUrl": {
                "type": ["string", "null"],
                "title": "Shop URL",
                "description": "Seller's shop page URL on Shopee.",
                "example": "https://shopee.co.id/shop/78901"
            },
            "shopCity": {
                "type": ["string", "null"],
                "title": "Shop city",
                "description": "Seller's registered city, useful for shipping and regional analysis.",
                "example": "Jakarta"
            },
            "shopRating": {
                "type": ["number", "null"],
                "title": "Shop rating",
                "description": "Seller's overall shop rating (1-5).",
                "example": 4.9
            },
            "responseRate": {
                "type": ["number", "null"],
                "title": "Response rate",
                "description": "Seller's chat response rate percentage.",
                "example": 98
            },
            "responseTime": {
                "type": ["string", "null"],
                "title": "Response time",
                "description": "Seller's average response time.",
                "example": "within hours"
            },
            "followerCount": {
                "type": ["number", "null"],
                "title": "Follower count",
                "description": "Number of followers the seller has.",
                "example": 15000
            },
            "isOfficialShop": {
                "type": "boolean",
                "title": "Official shop",
                "description": "True when the seller is an official/brand store on Shopee."
            },
            "isShopeeVerified": {
                "type": "boolean",
                "title": "Shopee verified",
                "description": "True when the seller holds Shopee's verified badge."
            },
            "rating": {
                "type": "number",
                "title": "Rating",
                "description": "Average product rating. 0 when the product has no ratings.",
                "example": 4.8
            },
            "ratingStar": {
                "type": "number",
                "title": "Rating star",
                "description": "Product rating star count (same as rating, explicit field).",
                "example": 4.8
            },
            "reviewCount": {
                "type": "number",
                "title": "Review count",
                "description": "Number of product reviews. 0 when the product has no reviews.",
                "example": 256
            },
            "historicalSold": {
                "type": ["number", "null"],
                "title": "Historical sold",
                "description": "Total units sold historically across all time.",
                "example": 15000
            },
            "stock": {
                "type": ["number", "null"],
                "title": "Stock",
                "description": "Current available stock. May be null if stock info is hidden.",
                "example": 500
            },
            "sold": {
                "type": ["number", "null"],
                "title": "Sold (30 days)",
                "description": "Units sold in the recent period (typically last 30 days).",
                "example": 320
            },
            "categoryId": {
                "type": ["number", "null"],
                "title": "Category ID",
                "description": "Shopee category ID.",
                "example": 11042
            },
            "categoryName": {
                "type": ["string", "null"],
                "title": "Category name",
                "description": "Shopee category name (if available from API).",
                "example": "Headset & Earphone"
            },
            "itemType": {
                "type": ["number", "null"],
                "title": "Item type",
                "description": "Product type indicator from Shopee API.",
                "example": 0
            },
            "likedCount": {
                "type": ["number", "null"],
                "title": "Liked count",
                "description": "Number of users who liked/wishlisted the product.",
                "example": 450
            },
            "commentCount": {
                "type": ["number", "null"],
                "title": "Comment count",
                "description": "Number of product comments.",
                "example": 89
            },
            "isAd": {
                "type": "boolean",
                "title": "Is advertisement",
                "description": "True if this product is a sponsored/advertisement result."
            },
            "flashSale": {
                "type": "boolean",
                "title": "Flash sale",
                "description": "True if this product is part of a flash sale."
            },
            "liked": {
                "type": "boolean",
                "title": "Liked",
                "description": "True if the product is in the user's liked items."
            },
            "fetchedAt": {
                "type": "string",
                "title": "Fetched at",
                "description": "ISO 8601 timestamp of when the item was extracted.",
                "example": "2026-09-18T05:30:00.000Z"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "description": "One row per product: what it is, what it costs, and where to buy it.",
            "transformation": {
                "fields": [
                    "imageUrl",
                    "name",
                    "price",
                    "originalPrice",
                    "discountPercent",
                    "shopName",
                    "url"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "imageUrl": {
                        "label": "Image",
                        "format": "image"
                    },
                    "name": {
                        "label": "Product",
                        "format": "text"
                    },
                    "price": {
                        "label": "Price (IDR)",
                        "format": "number"
                    },
                    "originalPrice": {
                        "label": "Was (IDR)",
                        "format": "number"
                    },
                    "discountPercent": {
                        "label": "Discount %",
                        "format": "number"
                    },
                    "shopName": {
                        "label": "Shop",
                        "format": "text"
                    },
                    "url": {
                        "label": "Link",
                        "format": "link"
                    }
                }
            }
        },
        "pricing": {
            "title": "Pricing analysis",
            "description": "Everything needed to compare price levels and discount depth across shops.",
            "transformation": {
                "fields": [
                    "name",
                    "price",
                    "priceMin",
                    "priceMax",
                    "originalPrice",
                    "discount",
                    "discountPercent",
                    "currency",
                    "shopName",
                    "shopCity"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "price": {
                        "label": "Price",
                        "format": "number"
                    },
                    "originalPrice": {
                        "label": "Original",
                        "format": "number"
                    },
                    "discount": {
                        "label": "Discount (IDR)",
                        "format": "number"
                    },
                    "discountPercent": {
                        "label": "Discount %",
                        "format": "number"
                    }
                }
            }
        },
        "sellers": {
            "title": "Sellers",
            "description": "Shop-level view: who is selling, where from, and how established they are.",
            "transformation": {
                "fields": [
                    "shopName",
                    "shopCity",
                    "shopRating",
                    "responseRate",
                    "followerCount",
                    "isOfficialShop",
                    "isShopeeVerified",
                    "rating",
                    "reviewCount",
                    "sold",
                    "name"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "shopRating": {
                        "label": "Shop Rating",
                        "format": "number"
                    },
                    "responseRate": {
                        "label": "Response %",
                        "format": "number"
                    },
                    "isOfficialShop": {
                        "label": "Official",
                        "format": "boolean"
                    },
                    "isShopeeVerified": {
                        "label": "Verified",
                        "format": "boolean"
                    },
                    "rating": {
                        "label": "Rating",
                        "format": "number"
                    },
                    "reviewCount": {
                        "label": "Reviews",
                        "format": "number"
                    },
                    "sold": {
                        "label": "Sold",
                        "format": "number"
                    }
                }
            }
        }
    }
}
